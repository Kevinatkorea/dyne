# =====================================================================
# server/.env — 서버에만 존재한다 (gitignore 됨)
# 값에 $ 가 들어가면 \$ 로 escape 할 것.
# =====================================================================
NODE_ENV=production
PORT=3410

# MariaDB (deploy/setup_db.sql 로 만든 계정)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dyne_app
DB_PASSWORD=__DBPW__
DB_NAME=dyne

# 세션 — 서버에서 openssl rand -hex 32 로 생성
JWT_SECRET=__JWT__
COOKIE_SECURE=true
SESSION_HOURS=12

# 업로드 (레포 밖에 두어 git pull 로 지워지지 않게)
UPLOAD_DIR=/home/website/dy.mostvisual.co.kr/uploads
MAX_UPLOAD_MB=30

SITE_URL=https://dy.mostvisual.co.kr

# 최초 시드가 만드는 관리자 계정 — 로그인 후 즉시 변경할 것
SEED_ADMIN_EMAIL=admin@dynes.co.kr
SEED_ADMIN_PASSWORD=__ADMINPW__
SEED_ADMIN_NAME=최고관리자
